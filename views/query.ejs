<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sia Chat Bot</title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>

    <header>
        <h1>Sia Chat Bot</h1>
        <h2>State the enquiry in box below</h2>
    </header>

    <div id="userForm">
        <form action="getResponse" method="POST">
            <label for="name">Name</label><br>
            <input name="name" type="text" id="name"><br><br>
            <label for="email">Email</label><br>
            <input name="email" type="text" id="email"><br><br>
            <label for="query">Enquiry</label><br>
            <textarea name="query" id="query" placeholder="Enter any issue you are having"></textarea><br>
            <button type="button" id="submit">Submit</button>
        </form>
    </div> 

   <div id="responseModal" class="responseModal">
      <div class="responseModal-content">
         <p id="message"><%= response %></p>} %> 
         <button type="button" id="closeBtn">Ok</button> 
         <form method="POST">
             <button type="button" id="escalateBtn">Escalate</button>
         </form>
     </div>
    </div>

   <script src="/script.js"></script>
</body>
</html>