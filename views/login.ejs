 <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login - Sia Chat Bot</title>
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <!-- Login division -->
  <div class="container">
    <h1>Login</h1>
    <form id="loginForm" action="/loginDetails" method="POST">
     <label for="email">Email:</label><br>
      <input type="email" id="loginEmail" name="email" placeholder="Email" required> <br >
      <label for="password">Password:</label><br>
      <input type="password" name="password" id="loginPassword" placeholder="Password" required> <br >
      <button type="submit">Login</button>
    </form>
    <p>Don't have an account? 
      <a href="signup.html">Sign Up</a>
    </p>

    <% if (locals.message) { %>
      <p class="error-message"><%= message %></p>
    <% } %>
  </div>
</body>
</html> 
